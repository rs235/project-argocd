---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: frontend
  namespace: photo-portfolio-website

spec:
  podSelector:
    matchLabels:
      io.kompose.service: frontend

  policyTypes:
    - Ingress
    - Egress

  ingress:
    - from:
        - ipBlock:
            cidr: 10.10.10.52/32
      ports:
        - protocol: TCP
          port: 8080
 